{
  "name": "pi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Codex-style desktop client for Pi",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 npm run electron:build && electron .\"",
    "bridge:apply": "node scripts/apply-rpc-bridge.mjs",
    "electron:build": "npm run bridge:apply && tsc -p tsconfig.electron.json",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run electron:build",
    "release:update": "node scripts/update-portable-fast.mjs",
    "start": "npm run bridge:apply && electron .",
    "pack": "npm run build && node scripts/package-portable.mjs",
    "portable": "npm run pack"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@zavora-ai/computer-use-mcp": "7.1.0",
    "ajv": "8.20.0",
    "diff": "8.0.4",
    "image-size": "2.0.4",
    "lucide-react": "1.38.0",
    "mammoth": "1.12.2",
    "pi-lens": "4.3.0",
    "pi-llama-cpp-stats": "0.1.6",
    "pi-mcp-adapter": "5.1.0",
    "pi-tool-repair": "0.3.5",
    "pi-web-access": "0.37.0",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "selfsigned": "5.5.0",
    "three": "0.186.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "44.1.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wait-on": "9.0.4"
  },
  "build": {
    "appId": "local.pi.desktop",
    "productName": "Pi Desktop",
    "asar": false,
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "CONNECT_CODEX.md",
        "to": "CONNECT_CODEX.md"
      },
      {
        "from": "resources/control-api/Invoke-PiDesktop.ps1",
        "to": "Invoke-PiDesktop.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
