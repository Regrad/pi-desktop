{
  "settings": {
    "requestTimeoutMs": 86400000
  },
  "mcpServers": {
    "godot-ai": {
      "url": "http://127.0.0.1:8000/mcp",
      "directTools": false
    },
    "computer-use": {
      "command": "${PI_DESKTOP_EXECUTABLE}",
      "args": ["${PI_DESKTOP_MCP_ENTRY}"],
      "env": {
        "ELECTRON_RUN_AS_NODE": "1"
      },
      "directTools": true
    }
  }
}
